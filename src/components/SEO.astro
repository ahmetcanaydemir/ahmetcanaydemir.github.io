---
import { getImage } from 'astro:assets';
import profilePic from '../assets/profile-pic.jpg';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedDate?: Date;
  noindex?: boolean;
}

const SITE_TITLE = 'Ahmet Can Aydemir';
const DEFAULT_DESCRIPTION =
  'Personal website of Ahmet Can Aydemir — software engineer at Amazon, writing about programming.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogType = 'website',
  publishedDate,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({
  src: profilePic,
  width: 400,
  height: 400,
  format: 'jpg',
});
const ogImageURL = new URL(ogImage.src, Astro.site).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Ahmet Can Aydemir" />
{noindex ? (
  <meta name="robots" content="noindex" />
) : (
  <link rel="canonical" href={canonicalURL.toString()} />
)}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="400" />
<meta property="og:image:height" content="400" />
<meta property="og:image:alt" content="Ahmet Can Aydemir" />
{publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{publishedDate && <meta property="article:author" content="Ahmet Can Aydemir" />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:creator" content="@ahmetcnaydemir" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
